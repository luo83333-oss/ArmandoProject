# 复制为 deploy/.env 后修改（勿提交仓库）
# docker compose -f docker-compose.prod.yml --env-file deploy/.env up -d --build

# MySQL
MYSQL_ROOT_PASSWORD=change_root_password
MYSQL_PASSWORD=change_db_password

# API（生产必改）
JWT_SECRET=change-to-random-string-at-least-32-chars
JWT_EXPIRE_HOURS=72
PAYMENT_MOCK_ENABLED=false
PAYMENT_SANDBOX_SECRET=

# 域名（解析到 ECS 公网 IP 后填写）
USER_DOMAIN=shop.example.com
MERCHANT_DOMAIN=merchant.example.com
ADMIN_DOMAIN=admin.example.com
